# Backboard credentials and the default model.
BACKBOARD_API_KEY=
BACKBOARD_LLM_PROVIDER=google
BACKBOARD_MODEL=
# bun run setup creates this assistant ID. One call per decision classifies the chat and picks the action.
BACKBOARD_CLASSIFIER_ID=
# Optional: choose the decider model. Defaults to the settings above.
BACKBOARD_CLASSIFIER_PROVIDER=
BACKBOARD_CLASSIFIER_MODEL=

# Copy exact group IDs from bun run list-chats. Separate IDs with commas.
ALLOWED_CHAT_IDS=
BOT_NAME=amigo
TZ=America/Los_Angeles
# shadow tracks state and logs decisions; live also enables proactive replies and scheduler output.
PASSIVE_MODE=shadow
DEBOUNCE_MS=45000
ALLOW_DMS=false
DATABASE_PATH=.data/miamigo.db
CONTACTS_PATH=contacts.json
# Override only when Messages uses a different local database path.
# MESSAGES_DATABASE_PATH=/absolute/path/to/chat.db
