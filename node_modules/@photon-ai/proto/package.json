{
  "name": "@photon-ai/proto",
  "version": "0.2.4",
  "description": "Generated TypeScript bindings for photon.slack.v1 and photon.fusor.v1 gRPC services.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "nice-grpc-common": "^2.0.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.69.0",
    "ts-proto": "^2.11.8",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "generate": "buf generate",
    "build": "tsup",
    "prepublishOnly": "npm run generate && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/proto.git",
    "directory": "public"
  },
  "license": "MIT"
}
